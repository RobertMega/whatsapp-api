// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id @default(uuid())
  name      String   @unique
  status    String   @default("disconnected") // disconnected | connecting | connected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
}

model Message {
  id         String   @id @default(uuid())
  sessionId  String
  to         String
  type       String   // text | image | file
  content    String
  status     String   @default("pending") // pending | sent | failed
  sentAt     DateTime @default(now())

  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SearchFilter {
  id        String   @id @default(cuid())
  term      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostingExecution {
  id                String           @id @default(cuid())
  status            String           @default("running")
  sentCount         Int              @default(0)
  skippedDuplicates Int              @default(0)
  errorMessage      String?
  startedAt         DateTime         @default(now())
  finishedAt        DateTime?

  offers            PublishedOffer[]
  failures          PostingFailure[]
}

model PublishedOffer {
  id            String            @id @default(cuid())
  executionId   String?
  itemId        String            @unique
  title         String
  price         Float
  permalink     String
  affiliateLink String
  groupJid      String
  postedAt      DateTime          @default(now())

  execution     PostingExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
}

model PostingFailure {
  id          String           @id @default(cuid())
  executionId String
  itemId      String
  reason      String
  failedAt    DateTime         @default(now())

  execution   PostingExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}
